# Copy to .env.local for local development. These are NOT secrets: Firebase web
# config is public by design and ends up in the built bundle either way. Access
# is governed by firebase.rules.json, not by hiding these values.
#
# Leave every line unset and the app still runs — it drops to local-only play
# with the ledger in localStorage and says so in the footer.
#
# For GitHub Pages, set the same five as repository *variables* (not secrets):
#   Settings -> Secrets and variables -> Actions -> Variables

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
